---
import { DOWNLOAD_URL } from "../consts";

interface Props {
  label?: string;
  appVersion?: string;
  showVersion?: boolean;
  variant?: "hero" | "section" | "compact";
  glow?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  label = "Download for Windows",
  appVersion,
  showVersion = false,
  variant = "hero",
  glow = false,
  class: className = "",
  ariaLabel = "Download TrueHour for Windows (.exe)",
} = Astro.props;

const variantClass =
  variant === "section"
    ? "btn-primary--section"
    : variant === "compact"
      ? "btn-primary--compact"
      : "btn-primary--hero";

const classes = ["btn-primary", variantClass, glow ? "glow-accent" : "", className]
  .filter(Boolean)
  .join(" ");
---

<a href={DOWNLOAD_URL} download class={classes} aria-label={ariaLabel}>
  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
  </svg>
  {label}
  {showVersion && appVersion ? <span class="text-sm font-normal opacity-70">v{appVersion}</span> : null}
</a>
